# Polygon wallet private key (with 0x prefix)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: Polymarket CLOB API key (generated via /auth/api-key endpoint)
# If not set, the bot will use L1 auth (slower but works without setup)
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# Underlying to trade (BTC, ETH, SOL, etc.)
UNDERLYING=BTC
